                                                                                                                                                                                                                                                                                                                                                                                                                                                         # Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
# Defaults to local SQLite if unset. Point at Postgres/Supabase for anything
# beyond local development.
DATABASE_URL=sqlite:///./recruitment.db
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- MCP Gateway auth ---
# Long random secret used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo user passwords (the gateway ships with 3 demo accounts: recruiter1,
# manager1, admin1). Replace with a real user store before going beyond a demo.
DEMO_RECRUITER_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_ADMIN_PASSWORD=

# --- MCP server location, as seen by the gateway ---
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# --- AI Recruitment Agent ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GATEWAY_URL=http://127.0.0.1:8000
AGENT_USERNAME=recruiter1
AGENT_PASSWORD=
